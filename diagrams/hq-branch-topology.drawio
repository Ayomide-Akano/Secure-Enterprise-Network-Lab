        <mxCell id="e11" value="802.1Q trunk VLANs 10,99; native 999" style="endArrow=none;html=1;" edge="1" parent="1" source="brr" target="bsw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="Access VLAN 10" style="endArrow=none;html=1;" edge="1" parent="1" source="bsw" target="bpc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="HQ: 10 STAFF, 20 FINANCE, 30 IT-ADMIN, 40 GUEST, 50 SERVERS, 99 MGMT. VLAN 60 DMZ uses 172.16.60.0/24 and stays off core trunks. VLAN 999 is native/blackhole with no IP. Branch: VLAN 10 STAFF, VLAN 99 MGMT. Design only; not yet built or tested. CORE-SW2 depends on CORE-SW1 for external routing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="830" y="470" width="330" height="180" as="geometry"/></mxCell>
