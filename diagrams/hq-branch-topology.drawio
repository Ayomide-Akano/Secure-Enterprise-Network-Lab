        <mxCell id="e3" value="LACP EtherChannel; VLANs 10,20,30,40,50,99,999; native 999" style="endArrow=none;html=1;strokeWidth=3;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
